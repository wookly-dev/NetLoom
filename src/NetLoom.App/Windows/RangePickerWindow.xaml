<Window x:Class="NetLoom.App.Windows.RangePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="스캔 범위 선택"
        Width="650" Height="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111111"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#171717"/><Setter Property="Background" Value="#FAD83B"/>
            <Setter Property="BorderBrush" Value="#FAD83B"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="#FAD83B"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="NetLoom 스캔 범위" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"><Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox></Button>
            </Grid>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="검색 범위" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AdapterInfoText" Text="현재 어댑터 정보" Foreground="#8A8A8A" FontSize="11" Margin="0,5,0,12"/>
                    <TextBox x:Name="TargetTextBox" FontSize="14" Height="72" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    <TextBlock Text="CIDR, 단일 IP, 시작 IP - 끝 IP를 지원합니다. 여러 서브넷은 줄바꿈 또는 ; 로 구분하세요." Foreground="#777" FontSize="10.5" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="빠른 선택" Foreground="#DADADA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="현재 어댑터 전체 대역" Click="UseAdapterSubnet_Click"/>
                        <Button Content="빠른 /24" Click="UseSlash24_Click"/>
                        <Button Content="이 PC IP만" Click="UseSingle_Click" Margin="0"/>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Row="2" Background="#181818" BorderBrush="#303030" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="시작 IP" Foreground="#999" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="StartIpTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="끝 IP" Foreground="#999" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="EndIpTextBox"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="범위 적용" Click="ApplyRange_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#211F13" BorderBrush="#4D4520" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,14,0,0">
                    <TextBlock x:Name="ValidationText" Text="범위를 선택하면 예상 스캔 주소 수를 확인합니다." Foreground="#CFC28A" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="4" Text="라우팅과 방화벽/ACL이 허용되면 동일 라우터 하위의 다른 서브넷도 스캔할 수 있습니다. 예: 192.168.10.0/24; 192.168.20.0/24" Foreground="#707070" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,16,0,0"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="취소" Click="Cancel_Click"/>
                    <Button Content="적용" Style="{StaticResource AccentButton}" Click="Apply_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
