<Window x:Class="NetLoom.App.Windows.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="정보"
        Width="580" Height="555"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111111"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="NetLoom 정보" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"><Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox></Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="58" Height="58" Background="#0C0C0C" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12">
                        <TextBlock Text="N" Foreground="#FAD83B" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,3,0,0">
                        <TextBlock Text="NetLoom" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Network Audit Scanner · v0.7.5" Foreground="#A7A7A7" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="© 2026 WooklyDev" Foreground="#FAD83B" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#181818" BorderBrush="#343434" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="용도" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="사내 전산 감사·자산 점검을 위한 IPv4 네트워크 스캐너입니다. ICMP, TCP Connect, DNS, ARP, 제한적인 SMB Guest 감사와 IPP/SNMP 장비 식별을 조합하며, Windows 라우팅 정보를 이용해 감사 후보 서브넷을 추천할 수 있습니다."
                                   Foreground="#BDBDBD" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <TextBlock Text="시각화" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="리스트 / 대역 그룹 매트릭스 / 2D 관계도 / 3D 궤도 관계도를 제공합니다. 관계도 노드를 클릭해 장비 상세, 포트, SMB 공유, IPP/SNMP 식별 정보를 확인할 수 있습니다."
                                   Foreground="#BDBDBD" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <TextBlock Text="공유폴더 감사 / 보고서" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="SMB가 감지되면 명시적인 Guest + 빈 암호 접근만 1회 확인합니다. 패스워드 추측은 하지 않습니다. 결과는 HTML 감사 보고서로 저장해 브라우저에서 인쇄/PDF 저장할 수 있습니다."
                                   Foreground="#BDBDBD" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <TextBlock Text="관계도 해석 주의" Foreground="#FAD83B" FontWeight="SemiBold"/>
                        <TextBlock Text="현재 2D/3D 관계도는 실제 스위치 포트 배선도를 증명하지 않습니다. SNMP 시스템 식별은 장비 유형 정확도를 높이는 용도이며, 물리/L2 경로 확정에는 LLDP/CDP와 스위치 MAC Address Table 수집이 추가로 필요합니다."
                                   Foreground="#CFC28A" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="본인이 관리하거나 스캔 권한을 부여받은 네트워크에서만 사용하십시오."
                           Foreground="#808080" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>

                <Button Content="닫기" HorizontalAlignment="Right" Margin="0,18,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
