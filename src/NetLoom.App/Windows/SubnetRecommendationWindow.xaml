<Window x:Class="NetLoom.App.Windows.SubnetRecommendationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="감사 대역 추천"
        Width="930" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111111"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#171717"/><Setter Property="Background" Value="#FAD83B"/>
            <Setter Property="BorderBrush" Value="#FAD83B"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="NetLoom 감사 대역 추천" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"><Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox></Button>
            </Grid>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="감사 대역 추천 · 라우팅 + SNMP 하위망" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="선택 어댑터뿐 아니라 현재 PC의 다른 활성 IPv4 어댑터/Windows 라우팅 정보와 스캔된 Router 계열 장비의 SNMP IPv4 인터페이스·라우팅 테이블을 합쳐 추천합니다. SNMP에서 발견했지만 현재 PC의 명시적 경로가 없는 대역은 '경로 미확인'으로 표시합니다."
                               Foreground="#8B8B8B" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,14,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AdapterText" Foreground="#B5B5B5" FontSize="11"/>
                        <TextBlock x:Name="RecommendationSummaryText" Foreground="#FAD83B" FontSize="9.8" Margin="0,3,0,0"/>
                        <TextBlock Text="기본 경로(0.0.0.0/0), 호스트/브로드캐스트(/32), 멀티캐스트 경로는 감사 대역 추천에서 제외됩니다." Foreground="#686868" FontSize="9.2" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="전체 선택" Padding="9,5" Click="SelectAll_Click"/>
                        <Button Content="라우팅 확인만" Padding="9,5" Click="SelectReachable_Click"/>
                        <Button Content="직접 대역만" Padding="9,5" Click="SelectDirect_Click" Margin="0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="#171717" BorderBrush="#333333" BorderThickness="1" CornerRadius="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RecommendationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="11,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/><ColumnDefinition Width="82"/><ColumnDefinition Width="145"/><ColumnDefinition Width="118"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                            <Border Grid.Column="1" Background="#282413" BorderBrush="#5C5120" BorderThickness="1" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding GroupLabel}" Foreground="#FAD83B" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Cidr}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EstimatedHostsText}" Foreground="#777" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source}" Foreground="#C2C2C2" FontSize="10.5"/>
                                                <TextBlock Text="{Binding Reachability}" Foreground="#76D7A7" FontSize="9.4" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ParentDevice}" Foreground="#D8C970" FontSize="9.8" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Gateway, StringFormat='Parent {0}'}" Foreground="#666" FontSize="9.3" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="5">
                                                <TextBlock Text="{Binding Reason}" Foreground="#999" FontSize="10.3" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="3" Background="#211F13" BorderBrush="#4D4520" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="'대역 발견 · 경로 미확인'은 장비가 해당 대역의 존재를 보고했다는 뜻이지 현재 감사 PC에서 바로 접근 가능하다는 뜻은 아닙니다. NetLoom은 Windows Route를 임의로 추가하거나 Router 설정을 변경하지 않습니다."
                               Foreground="#CFC28A" FontSize="10.5" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="취소" Click="Cancel_Click"/>
                    <Button Content="선택 대역 적용" Style="{StaticResource AccentButton}" Click="Apply_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
