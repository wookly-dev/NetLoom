<Window x:Class="NetLoom.App.Windows.SensorGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetLoom · 센서 구성 가이드"
        Width="780" Height="760" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#111111" Foreground="#EDEDED"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI"
        Icon="/Assets/AppIcon.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Background" Value="#FAD83B"/>
            <Setter Property="BorderBrush" Value="#FAD83B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FAD83B"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <Image Source="/Assets/AppIcon.png" Width="17" Height="17"/>
                    <TextBlock Text="NetLoom · 센서 구성 가이드" Foreground="White" FontWeight="SemiBold" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click">
                    <Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,16,18,18">
                    <TextBlock Text="패킷 관측 범위 이해" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="NetLoom의 외부 통신 관계도는 '실제로 센서가 본 패킷'만 근거로 만듭니다. 일반 스위치 포트에 연결된 LOCAL HOST 모드에서는 실행 PC의 외부 통신이 주로 보이며, 다른 PC의 외부 Unicast가 보이지 않는 것이 정상입니다."
                               Style="{StaticResource BodyText}" Margin="0,6,0,12"/>

                    <Border Background="#181818" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="현재 모드" Foreground="#858585" FontSize="9.8"/>
                                <TextBlock x:Name="ModeText" Text="LOCAL HOST" Foreground="#FAD83B" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="관측 상태" Foreground="#858585" FontSize="9.8"/>
                                <TextBlock x:Name="CoverageText" Text="관측 대기" Foreground="#DADADA" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PolicyText" Foreground="#777777" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CoverageDetailText" Foreground="#666666" FontSize="9.2" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="1. LOCAL HOST 모드" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="• 별도 스위치 설정 없이 사용할 수 있습니다.\n• 패킷 트레이서, DNS/SNI/HTTP 힌트, 실행 PC 기준 Baseline/Beacon 분석에 적합합니다.\n• 전체 사내 장비의 외부 통신을 대표하지 않으므로 기본값에서는 관찰 External/Public 노드를 2D/3D 관계도에서 숨깁니다.\n• 명시적으로 스캔 범위에 넣은 공인 IP 자산은 이 제한과 무관하게 표시됩니다."
                               Style="{StaticResource BodyText}" Margin="0,5,0,14"/>

                    <TextBlock Text="2. SPAN / Port Mirroring / TAP 모드" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="관리형 스위치에서 감시할 Source를 Uplink 포트 또는 감사 VLAN으로 지정하고, NetLoom 전용 NIC가 연결된 포트를 Mirror Destination으로 지정합니다. 스위치 제조사에 따라 SPAN, Port Mirroring, Mirror Port, Monitoring Port 등으로 표기됩니다."
                               Style="{StaticResource BodyText}" Margin="0,5,0,7"/>
                    <Border Background="#151515" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,0,0,8">
                        <TextBlock Text="권장 연결\nInternet / Firewall / Router  →  Managed Switch  →  사내 장비\n                                      └─ Mirror Destination  →  NetLoom 전용 NIC"
                                   Foreground="#CFCFCF" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="설정 순서\n1) 스위치에서 Source 포트/VLAN과 Destination 포트를 지정합니다.\n2) 가능하면 NetLoom 관제 PC의 전용 유선 NIC를 Destination 포트에 연결합니다.\n3) NetLoom 설정 → 패킷 관측 범위를 'SPAN / TAP'으로 선택합니다.\n4) 동일한 NIC를 NetLoom 어댑터로 선택하고 '실시간 통신'을 시작합니다.\n5) 다른 사내 PC에서 웹 접속 등 정상 외부 통신을 발생시킵니다.\n6) NetLoom 상태가 'SPAN 확인'으로 바뀌고 Transit 패킷/내부 호스트 수가 증가하는지 확인합니다."
                               Style="{StaticResource BodyText}" Margin="0,3,0,14"/>

                    <TextBlock Text="3. 자동 검증과 외부 관계도 제한" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="SPAN/TAP 모드를 선택했다고 해서 즉시 전체망 관측으로 간주하지 않습니다. NetLoom 실행 PC의 IP가 Source/Destination 어느 쪽에도 없는 정상 Unicast(Transit)를 실제로 확인한 뒤에만 SPAN을 '확인' 상태로 올립니다. 그 전에는 관찰 External/Public 노드를 관계도에서 숨겨 잘못된 전체망 표현을 방지합니다."
                               Style="{StaticResource BodyText}" Margin="0,5,0,14"/>

                    <TextBlock Text="4. 확인되지 않을 때 점검" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="• Mirror Source가 실제 Uplink 또는 원하는 VLAN인지 확인\n• Destination 포트가 NetLoom NIC가 연결된 포트인지 확인\n• Ingress/Egress 또는 Both 방향 옵션 확인\n• 스위치가 Mirror Destination 포트의 일반 통신을 제한하는 모델인지 확인\n• 가상 NIC/VPN이 아니라 실제 미러링을 받는 물리 NIC를 NetLoom에서 선택했는지 확인\n• Windows Raw Socket/드라이버 조합에서 Transit이 노출되지 않는 경우 향후 Npcap Provider가 필요할 수 있음"
                               Style="{StaticResource BodyText}" Margin="0,5,0,14"/>

                    <Border Background="#211F13" BorderBrush="#4D4520" BorderThickness="1" CornerRadius="5" Padding="11">
                        <StackPanel>
                            <TextBlock Text="운영 권장" Foreground="#FAD83B" FontWeight="SemiBold" FontSize="11.5"/>
                            <TextBlock Text="장기 관제에서는 Mirror 전용 NIC를 별도로 두는 것이 좋습니다. SPAN/TAP은 패킷 수준 분석에 적합하고, 대규모/장기 메타데이터 관제는 향후 NetFlow/IPFIX 수신 Provider를 별도 추가하는 방향이 적합합니다."
                                       Foreground="#CFC28A" FontSize="10.2" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0B0B0B" BorderBrush="#303030" BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Button Content="체크리스트 복사" HorizontalAlignment="Left" Click="CopyChecklist_Click"/>
                    <Button Content="닫기" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
