<Window x:Class="NetLoom.App.Windows.SecurityTimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetLoom · 보안 타임라인" Width="1080" Height="650" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#111111" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#171717"/><Setter Property="Background" Value="#FAD83B"/><Setter Property="BorderBrush" Value="#FAD83B"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171717"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#2C2C2C"/>
            <Setter Property="RowBackground" Value="#171717"/><Setter Property="AlternatingRowBackground" Value="#191919"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3B3B3B"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="9,8"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="보안 타임라인 · 관계도 시점 재생" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"><Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox></Button>
            </Grid>
            <Border Grid.Row="1" Background="#151515" BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↻ 새로고침" Click="Refresh_Click"/>
                        <Button Content="선택 시점 적용" Style="{StaticResource AccentButton}" Click="Apply_Click"/>
                        <Button Content="LIVE 복귀" Click="Live_Click"/>
                        <Button Content="CSV 저장" Click="Export_Click"/>
                        <Button Content="타임라인 지우기" Click="Clear_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="CountText" Foreground="#8E8E8E" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataGrid Grid.Row="2" x:Name="TimelineGrid" ItemsSource="{Binding Entries}" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="95" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="HIGH" Binding="{Binding HighCount}" Width="68" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="MED" Binding="{Binding MediumCount}" Width="68" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="WATCH" Binding="{Binding WatchCount}" Width="72" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="DNS" Binding="{Binding DnsAnomalyCount}" Width="68" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="Beacon" Binding="{Binding BeaconCount}" Width="76" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="횡적" Binding="{Binding LateralCount}" Width="68" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="Baseline" Binding="{Binding BaselineAnomalyCount}" Width="80" ElementStyle="{StaticResource DataGridCellText}"/>
                    <DataGridTextColumn Header="상위 위험 노드" Binding="{Binding TopRiskText}" Width="*" MinWidth="320" ElementStyle="{StaticResource DataGridCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Background="#0A0A0A">
                <TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" Foreground="#777" FontSize="9.8" Text="세션 중 메타데이터 스냅샷만 메모리에 유지합니다. 시점 적용은 관계도 표시만 재생하며 실제 분석 상태를 되돌리지 않습니다."/>
            </Grid>
        </Grid>
    </Border>
</Window>
