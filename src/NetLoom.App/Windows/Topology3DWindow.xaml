<Window x:Class="NetLoom.App.Windows.Topology3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetLoom · 3D Topology"
        Width="1380" Height="860" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#111111" Foreground="#F2F2F2"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="Background" Value="#1D1D1D"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#282828"/><Setter Property="BorderBrush" Value="#555555"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#404040"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SpeedSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="100"/><Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#FAD83B"/><Setter Property="Background" Value="#393939"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
        <Style x:Key="CompactCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#C5C5C5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Background="#111111" BorderBrush="#090909" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="#050505" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <Border Width="17" Height="17" CornerRadius="3" Background="#151515" BorderBrush="#FAD83B" BorderThickness="1">
                        <TextBlock Text="N" Foreground="#FAD83B" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NetLoom · 3D Topology" Foreground="#EDEDED" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Click="Minimize_Click" Style="{StaticResource WindowControlButton}">
                    <Viewbox Width="11" Height="11"><Canvas Width="11" Height="11"><Line X1="1.5" Y1="7.5" X2="9.5" Y2="7.5" Stroke="#D8D8D8" StrokeThickness="1.1"/></Canvas></Viewbox>
                </Button>
                <Button Grid.Column="2" Click="Maximize_Click" Style="{StaticResource WindowMaximizeButton}"/>
                <Button Grid.Column="3" Click="Close_Click" Style="{StaticResource WindowCloseButton}">
                    <Viewbox Width="11" Height="11"><Canvas Width="11" Height="11"><Line X1="1.5" Y1="1.5" X2="9.5" Y2="9.5" Stroke="#E8E8E8" StrokeThickness="1.1"/><Line X1="9.5" Y1="1.5" X2="1.5" Y2="9.5" Stroke="#E8E8E8" StrokeThickness="1.1"/></Canvas></Viewbox>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#181818" BorderBrush="#303030" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="3D ORBIT TOPOLOGY" FontSize="14" FontWeight="SemiBold" Foreground="#FAD83B"/>
                        <TextBlock Text="분류별 다중 궤도 · 구체형 노드 · 위성 관계 · 기울기/이심률 · 가속/감속 · 게임형 카메라 조작"
                                   Foreground="#929292" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="새로고침" Click="Refresh_Click"/>
                        <Button Content="패킷 트레이서" Click="PacketInspector_Click"/>
                        <Button x:Name="OrbitMotionButton" Content="궤도 이동: ON" Click="OrbitMotion_Click"/>
                        <Border Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="속도" Foreground="#AFAFAF" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <Button Content="−" Width="28" Height="28" Padding="0" Margin="0,0,5,0" ToolTip="속도 감소" Click="SpeedDecrease_Click"/>
                                <Slider x:Name="SpeedSlider" Style="{StaticResource SpeedSliderStyle}" Width="122" Minimum="0.1" Maximum="10.0" Value="1.0" SmallChange="0.1" LargeChange="1.0" ValueChanged="SpeedSlider_ValueChanged"/>
                                <TextBox x:Name="SpeedTextBox" Text="1.0" Width="50" Height="28" Margin="7,0,3,0" TextAlignment="Center" ToolTip="0.1~10.0 배속 직접 입력" KeyDown="SpeedTextBox_KeyDown" LostFocus="SpeedTextBox_LostFocus"/>
                                <TextBlock Text="×" Foreground="#8C8C8C" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Button Content="+" Width="28" Height="28" Padding="0" Margin="0" ToolTip="속도 증가" Click="SpeedIncrease_Click"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="LabelModeButton" Content="라벨: 자동" Click="LabelMode_Click"/>
                        <Button Content="시점 초기화" Click="ResetView_Click"/>
                        <Button Content="위에서 보기" Click="TopView_Click" Margin="0"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#303030" BorderThickness="0,0,1,0">
                    <Grid x:Name="ViewportHost" ClipToBounds="True" SizeChanged="ViewportHost_SizeChanged">
                        <Border>
                            <Border.Background>
                                <RadialGradientBrush Center="0.48,0.44" GradientOrigin="0.48,0.44" RadiusX="0.8" RadiusY="0.8">
                                    <GradientStop Color="#11131B" Offset="0"/>
                                    <GradientStop Color="#080A0F" Offset="0.58"/>
                                    <GradientStop Color="#030407" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas x:Name="StarfieldCanvas" IsHitTestVisible="False"/>
                        <Viewport3D x:Name="TopologyViewport"
                                    Focusable="True"
                                    FocusVisualStyle="{x:Null}"/>
                        <!-- Full-area camera input surface. It sits below the label layer so device labels remain clickable. -->
                        <Border x:Name="ViewportInputSurface"
                                Background="Transparent"
                                Focusable="False"
                                PreviewMouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                                PreviewMouseRightButtonDown="Viewport_MouseRightButtonDown"
                                PreviewMouseRightButtonUp="Viewport_MouseRightButtonUp"
                                PreviewMouseMove="Viewport_MouseMove"
                                PreviewMouseWheel="Viewport_MouseWheel"
                                LostMouseCapture="Viewport_LostMouseCapture"/>
                        <Canvas x:Name="TrafficOverlayCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                        <!-- Canvas itself has no background, so only the visible label cards intercept input. -->
                        <Canvas x:Name="LabelCanvas" IsHitTestVisible="True" ClipToBounds="True"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="9,6" CornerRadius="5"
                                Background="#C8101010" BorderBrush="#353535" BorderThickness="1" IsHitTestVisible="False">
                            <TextBlock Text="좌 드래그: 자유 회전 · 노드에서 드래그: 해당 노드 중심 · 우 드래그/Shift+좌: 이동 · 휠: 커서 줌 · 노드 더블클릭: 포커스 · 빈 공간 더블클릭: 시점 유지 · 초기화는 상단 버튼"
                                       Foreground="#989898" FontSize="9.7"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#171717">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="선택 노드" Foreground="#FAD83B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedTypeText" Text="노드를 클릭하세요" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedIpText" Text="-" Foreground="#CFCFCF" FontSize="13"/>
                            <TextBlock x:Name="SelectedHostText" Text="-" Foreground="#8F8F8F" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="OpenDetailButton" Content="장비 상세 열기" Click="OpenDetail_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                <Button Content="패킷 보기" Click="PacketInspector_Click" Margin="0" ToolTip="선택한 노드 IP를 필터로 패킷 트레이서를 엽니다."/>
                            </StackPanel>

                            <Border Background="#1D1A12" BorderBrush="#4A4020" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="선택 노드 통신" Foreground="#9A9A9A" FontSize="9.5"/>
                                    <TextBlock x:Name="SelectedSecurityText" Text="보안: 분석 대기" Foreground="#8E8E8E" FontSize="9.7" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedTrafficText" Text="통신 기록 없음" Foreground="#8E8E8E" FontSize="9.7" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#141C18" BorderBrush="#29483A" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="실시간 통신" Foreground="#9A9A9A" FontSize="9.5"/>
                                    <TextBlock x:Name="TrafficLiveText" Text="캡처 대기" Foreground="#7D7D7D" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    <TextBlock Text="녹색 발광/이동 Pulse는 현재 실제로 관찰되는 통신입니다." Foreground="#686868" FontSize="9.2" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Button Content="패킷 단위 보기" Padding="8,5" Margin="0,7,0,0" Click="PacketInspector_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151A18" BorderBrush="#30453B" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="센서 관측 범위" Foreground="#9A9A9A" FontSize="9.5"/>
                                    <TextBlock x:Name="SensorCoverageText" Text="LOCAL HOST · 외부 관계 제한" Foreground="#9E9E9E" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SensorCoverageDetailText" Text="전체망 외부 통신 감사에는 SPAN/Port Mirroring/TAP 구성이 필요합니다." Foreground="#6E8178" FontSize="9.2" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Button Content="센서 구성 가이드" Padding="8,5" Margin="0,7,0,0" Click="SensorGuide_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#201D12" BorderBrush="#4A4020" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="통신 감사 기록" Foreground="#9A9A9A" FontSize="9.5"/>
                                    <TextBlock x:Name="TrafficAuditText" Text="기록 없음" Foreground="#8E8E8E" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Button x:Name="TrafficAuditToggleButton" Content="● 기록 시작" Padding="8,5" Click="TrafficAuditToggle_Click"/>
                                        <Button x:Name="TrafficAuditOpenButton" Content="기록 보기" Padding="8,5" Click="TrafficAuditOpen_Click" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="노란/주황 연결선과 노드 발광은 기록 시작~종료 구간에 관찰된 누적 통신입니다. 녹색은 현재 LIVE, 노란색은 감사 이력입니다." Foreground="#756E52" FontSize="9.2" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#211713" BorderBrush="#704130" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="관계도 보안 감사" Foreground="#FFB07A" FontSize="9.8" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SecurityRelationshipText" Text="분석 대기" Foreground="#8E8E8E" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Button x:Name="SecurityRelationshipResetButton" Content="보안 분석 초기화" Padding="8,5" Margin="0,0,7,0" Click="SecurityRelationshipReset_Click" IsEnabled="False"
                                                ToolTip="현재 실행 중 누적한 관계도 보안 분석 세션만 초기화합니다. Baseline 학습값은 유지됩니다."/>
                                        <Button Content="Baseline 초기화" Padding="8,5" Margin="0" Click="SecurityBaselineReset_Click"
                                                ToolTip="장비별 정상 행동 Baseline 학습값을 전체 삭제합니다. 현재 분석 세션은 유지됩니다."/>
                                    </StackPanel>
                                    <TextBlock Text="빨강/주황/노랑 발광과 연결선은 휴리스틱 기반 감사 우선순위입니다. Baseline, Beaconing, 내부 관리포트 확산을 포함하며 악성 판정이 아니라 조사 대상 선별용입니다."
                                               Foreground="#9A765F" FontSize="9.2" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1820" BorderBrush="#3A3448" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="External / Public 관찰 이력" Foreground="#C6B8E8" FontSize="9.8" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ExternalHistoryText" Text="관찰 이력 없음" Foreground="#8E8E8E" FontSize="10.5" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="ExternalIncludeLowSignificanceCheck" Content="저중요 External까지 표시" Style="{StaticResource CompactCheckBox}" Margin="0,7,0,0"
                                              ToolTip="기본은 장비별 중요 Flow와 보안 우선 Flow만 표시합니다. 원본 패킷/Flow는 숨기더라도 계속 분석됩니다."
                                              Checked="ExternalDetailMode_Changed" Unchecked="ExternalDetailMode_Changed"/>
                                    <CheckBox x:Name="ExternalExcludeSensorHostConnectionsCheck" Content="실행 PC External 연결 숨김" Style="{StaticResource CompactCheckBox}" Margin="0,3,0,0"
                                              ToolTip="NetLoom 실행 PC와 External/Public 사이의 passive 연결만 3D 시각화에서 제외합니다. 원본 패킷·보안 분석·감사 데이터는 유지됩니다."
                                              Checked="SensorHostConnectionVisibility_Changed" Unchecked="SensorHostConnectionVisibility_Changed"/>
                                    <Button x:Name="ExternalHistoryClearButton" Content="외부 이력 지우기" Padding="8,5" Margin="0,7,0,0" Click="ExternalHistoryClear_Click"
                                            ToolTip="이번 실행에서 실시간/감사 중 관찰되어 유지 중인 External/Public 노드와 연결 이력을 지웁니다. 실제 스캔 대상 공인 IP는 유지됩니다."/>
                                    <TextBlock Text="기본 관계도는 Significant Flow Rendering을 적용해 센서 PC의 단발성 SaaS/CDN 연결을 억제합니다. 필요하면 실행 PC 연결을 시각화에서 완전히 제외할 수 있습니다. 보안 위험, 반복/장기, 대량 통신, 여러 내부 장비가 공유하는 목적지는 우선 표시되며 원본 이력은 삭제되지 않습니다."
                                               Foreground="#827A96" FontSize="9.2" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="#303030" Margin="0,14"/>
                            <TextBlock Text="분류 강조" Foreground="#AFAFAF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="선택 분류는 유지하고 나머지 노드와 궤도는 흐리게 표시합니다." Foreground="#727272" FontSize="9.8" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="FilterInfrastructureCheck" Content="인프라" Style="{StaticResource CompactCheckBox}" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed"/>
                                <CheckBox x:Name="FilterSpecialCheck" Content="서버/NAS" Style="{StaticResource CompactCheckBox}" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed"/>
                                <CheckBox x:Name="FilterPeripheralCheck" Content="주변장비" Style="{StaticResource CompactCheckBox}" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed"/>
                                <CheckBox x:Name="FilterEndpointCheck" Content="엔드포인트" Style="{StaticResource CompactCheckBox}" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed"/>
                                <CheckBox x:Name="FilterOtherCheck" Content="기타" Style="{StaticResource CompactCheckBox}" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed"/>
                                <CheckBox x:Name="FilterExternalCheck" Content="외부" Style="{StaticResource CompactCheckBox}" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed"/>
                            </UniformGrid>
                            <Button Content="필터 초기화" Click="ResetCategoryFilter_Click" Margin="0,1,0,8" Padding="9,5"/>
                            <CheckBox x:Name="HideIsolatedCheck" Content="고립 노드 숨김" Style="{StaticResource CompactCheckBox}" Checked="HideIsolated_Changed" Unchecked="HideIsolated_Changed"/>
                            <TextBlock Text="고립 노드 숨김은 추정/확인된 부모·자식 관계가 없는 독립 단말을 화면에서 숨깁니다. 기본값은 OFF입니다."
                                       Foreground="#686868" FontSize="9.5" TextWrapping="Wrap"/>

                            <Border Height="1" Background="#303030" Margin="0,14"/>
                            <TextBlock Text="궤도 구분" Foreground="#AFAFAF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="●  네트워크 인프라" Foreground="#FAD83B" FontSize="11" Margin="0,8,0,0"/>
                            <TextBlock Text="●  서버 / NAS / 가상화" Foreground="#7599D3" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="●  프린터 / 전화 / 카메라 / UPS" Foreground="#C9C9C9" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="●  PC / 모바일 / IoT" Foreground="#9C9C9C" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="●  기타 / 미분류" Foreground="#8C7D9D" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="●  External / Public" Foreground="#C6B8E8" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="◌  AP/Extender 하위 추정 장비 = 위성" Foreground="#7CAFC8" FontSize="11" Margin="0,5,0,0"/>

                            <Border Height="1" Background="#303030" Margin="0,14"/>
                            <TextBlock Text="운동 모델" Foreground="#AFAFAF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MotionStateText" Text="가속도 적용 · 속도 0.0×" Foreground="#FAD83B" FontSize="10.5" Margin="0,8,0,0"/>
                            <TextBlock Text="속도는 슬라이더 또는 숫자 입력으로 0.1×~10.0× 사이에서 설정합니다. 시작/정지는 가속·감속하며, 이심률에 따라 공전 속도가 미세하게 달라집니다."
                                       Foreground="#7F7F7F" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>

