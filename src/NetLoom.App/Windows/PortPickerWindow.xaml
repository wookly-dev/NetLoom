<Window x:Class="NetLoom.App.Windows.PortPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="포트 선택"
        Width="820" Height="650"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#111111"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Background" Value="#FAD83B"/>
            <Setter Property="BorderBrush" Value="#FAD83B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#FAD83B"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#292929"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A3520"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2C2C2C"/>
            <Setter Property="RowBackground" Value="#171717"/>
            <Setter Property="AlternatingRowBackground" Value="#191919"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#3B3B3B"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="포트 선택 · TCP Connect 감사 목록" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"><Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox></Button>
            </Grid>

            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="검색" Foreground="#A7A7A7" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchTextBox" TextChanged="Filter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="분류" Foreground="#A7A7A7" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryCombo" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="프리셋" Foreground="#A7A7A7" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="감사 기본" Tag="감사 기본" Click="Preset_Click"/>
                    <Button Content="Windows" Tag="Windows" Click="Preset_Click"/>
                    <Button Content="서버" Tag="서버" Click="Preset_Click"/>
                    <Button Content="네트워크 장비" Tag="네트워크 장비" Click="Preset_Click"/>
                    <Button Content="NAS" Tag="NAS" Click="Preset_Click"/>
                    <Button Content="프린터" Tag="프린터" Click="Preset_Click"/>
                    <Button Content="VoIP" Tag="인터넷 전화/VoIP" Click="Preset_Click"/>
                    <Button Content="가상화" Tag="가상화" Click="Preset_Click"/>
                    <Button Content="SMB" Tag="공유폴더/SMB" Click="Preset_Click"/>
                    <Button Content="카메라/IoT" Tag="카메라/IoT" Click="Preset_Click"/>
                </WrapPanel>

                <DataGrid Grid.Row="2" x:Name="PortsGrid" ItemsSource="{Binding PortItems}" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                        <DataGridTextColumn Header="포트" Binding="{Binding Port}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="서비스" Binding="{Binding Service}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource DataGridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCountText" Foreground="#FAD83B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text=" · TCP 포트는 최대 64개까지 선택할 수 있습니다." Foreground="#888888" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="전체 해제" Click="Clear_Click"/>
                        <Button Content="취소" Click="Cancel_Click"/>
                        <Button Content="선택 적용" Style="{StaticResource AccentButton}" Click="Apply_Click" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
