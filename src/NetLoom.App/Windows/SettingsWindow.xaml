<Window x:Class="NetLoom.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="설정"
        Width="640" Height="840"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#111111"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Background" Value="#FAD83B"/>
            <Setter Property="BorderBrush" Value="#FAD83B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Settings ComboBox: paint both the closed selection and popup explicitly.
             The native Windows template can ignore Background/Foreground and render a white field. -->
        <Style x:Key="SettingsDarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#292929"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3520"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsDarkComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="33"/>
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsDarkComboBoxItem}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <ContentPresenter Margin="10,0,34,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="#F2F2F2"/>
                                    <Path Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="#A8A8A8" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,11,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#181818" BorderBrush="#414141" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240" Margin="0,3,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#716421"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="NetLoom 설정" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click"><Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox></Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="스캔 동작" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ResolveDnsCheck" Content="ONLINE 장비의 DNS 호스트명 조회"/>
                    <CheckBox x:Name="ResolveMacCheck" Content="로컬 서브넷의 MAC 주소(ARP) 조회"/>
                    <CheckBox x:Name="ShowOfflineCheck" Content="리스트 보기에 OFFLINE 결과도 표시"/>
                    <CheckBox x:Name="AutoMatrixCheck" Content="스캔 시작 시 매트릭스 보기로 자동 전환"/>
                    <CheckBox x:Name="LiveTopologyCheck" Content="스캔 중 관계도를 실시간 갱신"/>
                    <CheckBox x:Name="LightTopologyCheck" Content="관계도 출력(PNG · 인쇄 · 감사보고서)은 라이트 테마로 생성"/>
                    <CheckBox x:Name="AuditSmbCheck" Content="SMB 공유폴더 감사 (445/139 감지 장비)" Checked="AuditSmbCheck_Changed" Unchecked="AuditSmbCheck_Changed"/>
                    <CheckBox x:Name="GuestShareCheck" Content="Guest + 빈 암호로 무자격 공유 접근 가능 여부 확인" Margin="20,0,0,12"/>
                    <CheckBox x:Name="IdentityProbeCheck" Content="장비 식별 보조 프로브 (프린터 · NAS · 가상화 주요 포트)"/>

                    <Border Background="#171717" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="프로토콜 장비 식별" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="포트 추정에 더해 장비가 직접 제공하는 표준 관리 정보를 조회합니다."
                                       Foreground="#858585" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,10"/>
                            <CheckBox x:Name="IppQueryCheck" Content="IPP 프린터 정보 자동 조회 (TCP/631 감지 장비)"/>
                            <CheckBox x:Name="SnmpQueryCheck" Content="SNMP v2c Read-Only 장비 정보 조회" Checked="SnmpQueryCheck_Changed" Unchecked="SnmpQueryCheck_Changed"/>
                            <CheckBox x:Name="NestedDiscoveryCheck" Content="SNMP 인터페이스/라우팅 테이블에서 하위 네트워크 탐색" Margin="20,0,0,12"/>
                            <Grid Margin="20,-4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Community" Foreground="#A8A8A8" FontSize="11" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="SnmpCommunityBox" Grid.Column="1" Height="31"
                                             Background="#121212" Foreground="#F2F2F2" BorderBrush="#3A3A3A" BorderThickness="1"
                                             Padding="9,5"/>
                            </Grid>
                            <TextBlock Text="SNMP community는 로컬 settings.json에 저장됩니다. 감사용 읽기 전용 값 사용을 권장합니다."
                                       Foreground="#6F6F6F" FontSize="9.7" TextWrapping="Wrap" Margin="20,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#171717" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="패킷 관측 범위" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="LOCAL HOST는 실행 PC 중심 관측입니다. 사내 전체 외부 통신 감사에는 관리형 스위치의 SPAN/Port Mirroring 또는 TAP 구성이 필요합니다."
                                       Foreground="#858585" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,9"/>
                            <ComboBox x:Name="CaptureScopeCombo" Style="{StaticResource SettingsDarkComboBox}"
                                      SelectionChanged="CaptureScopeCombo_SelectionChanged">
                                <ComboBoxItem Style="{StaticResource SettingsDarkComboBoxItem}" Tag="LocalHost" Content="LOCAL HOST · 실행 PC 중심 관측"/>
                                <ComboBoxItem Style="{StaticResource SettingsDarkComboBoxItem}" Tag="SpanTap" Content="SPAN / TAP · 미러 포트 관측"/>
                            </ComboBox>
                            <CheckBox x:Name="ShowLocalExternalTopologyCheck" Content="LOCAL 모드에서도 실행 PC의 관찰 외부 노드를 관계도에 제한 표시" Margin="0,9,0,4"/>
                            <CheckBox x:Name="ShowLowSignificanceExternalTopologyCheck" Content="관계도에 저중요 External/Public 연결까지 모두 표시" Margin="0,3,0,4"/>
                            <CheckBox x:Name="ExcludeSensorHostTopologyConnectionsCheck" Content="관계도에서 NetLoom 실행 PC의 External/Public 연결 노드/선을 제외 (기본)" Margin="0,3,0,4"
                                      ToolTip="시각화에서만 실행 PC와 External/Public 사이의 관계도 연결선을 숨깁니다. 원본 패킷, 보안 분석, 감사 이력과 보고서 원시 데이터는 유지됩니다."/>
                            <TextBlock Text="기본값은 중요 연결만 표시합니다. 실행 PC 연결 제외/저중요 숨김은 관계도 렌더링 정책이며 패킷 트레이서·보안 분석·감사 이력의 원본 Flow는 삭제하지 않습니다."
                                       Foreground="#7C7250" FontSize="9.7" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock x:Name="CaptureScopeHintText" Text="LOCAL 기본값에서는 관찰 External/Public 노드를 관계도에서 숨겨 전체망 관제로 오해하지 않도록 합니다."
                                       Foreground="#6F6F6F" FontSize="9.7" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Background="#211F13" BorderBrush="#4D4520" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="감사 모드 원칙" Foreground="#FAD83B" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="ICMP 응답이 없어도 선택한 TCP 포트는 계속 확인합니다. IPP는 TCP/631이 확인된 장비에서 표준 프린터 속성을 읽습니다. SNMP v2c는 사용자가 입력한 읽기 전용 community로 시스템 정보를 조회하며 임의 community 대입은 하지 않습니다. 하위 네트워크 탐색은 Router/Firewall/Switch 계열이 보고하는 IPv4 인터페이스와 라우팅 테이블만 읽고 Windows 라우팅 여부와 구분해 표시합니다. SMB 감사는 명시적인 Guest + 빈 암호 접근만 1회 확인합니다."
                                   Foreground="#CFC28A" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" Text="설정은 %LOCALAPPDATA%\WooklyDev\NetLoom\settings.json 에 저장됩니다."
                           Foreground="#777777" FontSize="11" VerticalAlignment="Bottom" Margin="0,14,0,0"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="취소" Click="Cancel_Click"/>
                    <Button Content="저장" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
