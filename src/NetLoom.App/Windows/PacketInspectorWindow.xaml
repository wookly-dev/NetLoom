<Window x:Class="NetLoom.App.Windows.PacketInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetLoom · 패킷 트레이서" Width="1480" Height="820" MinWidth="1050" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" Background="#0F0F0F" Foreground="#E8E8E8"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI"
        Icon="/Assets/AppIcon.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TraceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#7F722C"/><Setter TargetName="Bd" Property="Background" Value="#25231A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#34301D"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TraceAccentButton" TargetType="Button" BasedOn="{StaticResource TraceButton}">
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="Background" Value="#FAD83B"/>
            <Setter Property="BorderBrush" Value="#FAD83B"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="#EAEAEA"/><Setter Property="BorderBrush" Value="#383838"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="7,6"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource NetLoomDataGridCellBase}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E4E4E4"/><Setter Property="BorderBrush" Value="#2B2B2B"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="5,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#294D68"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#161616"/><Setter Property="Foreground" Value="#E5E5E5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasKeywordHit}" Value="True"><Setter Property="Background" Value="#332B12"/><Setter Property="Foreground" Value="#F7E8A2"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSecuritySuspicious}" Value="True"><Setter Property="Background" Value="#351B1B"/><Setter Property="Foreground" Value="#FFD7CE"/></DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#294D68"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="#404040"/><Setter Property="CaretBrush" Value="#FAD83B"/><Setter Property="Padding" Value="7,5"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#303030" BorderThickness="1" Background="#0F0F0F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar: same non-client strategy/icon geometry as the main/3D windows. -->
            <Grid Grid.Row="0" Background="#050505" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <Border Width="17" Height="17" CornerRadius="3" Background="#151515" BorderBrush="#FAD83B" BorderThickness="1">
                        <TextBlock Text="N" Foreground="#FAD83B" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NetLoom · 패킷 트레이서" Foreground="#EDEDED" FontWeight="SemiBold" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowControlButton}" Click="Minimize_Click">
                    <Viewbox Width="11" Height="11"><Canvas Width="11" Height="11"><Line X1="1.5" Y1="7.5" X2="9.5" Y2="7.5" Stroke="#D8D8D8" StrokeThickness="1.1"/></Canvas></Viewbox>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource WindowMaximizeButton}" Click="Maximize_Click"/>
                <Button Grid.Column="3" Style="{StaticResource WindowCloseButton}" Click="Close_Click">
                    <Viewbox Width="11" Height="11"><Canvas Width="11" Height="11"><Line X1="1.5" Y1="1.5" X2="9.5" Y2="9.5" Stroke="#E8E8E8" StrokeThickness="1.1"/><Line X1="9.5" Y1="1.5" X2="1.5" Y2="9.5" Stroke="#E8E8E8" StrokeThickness="1.1"/></Canvas></Viewbox>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#121212" BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button x:Name="CaptureButton" Style="{StaticResource TraceAccentButton}" Content="▶ 캡처 시작" Click="Capture_Click"/>
                        <Button Style="{StaticResource TraceButton}" Content="⌫ 목록 지우기" Click="Clear_Click"/>
                        <Button Style="{StaticResource TraceButton}" Content="⇩ CSV 저장" Click="ExportCsv_Click"/>
                        <Button x:Name="AuditRecordButton" Style="{StaticResource TraceButton}" Content="● 감사 기록" Click="TraceRecord_Click"
                                ToolTip="시작~종료 동안 보이는 패킷 메타데이터와 마스킹된 미리보기를 감사 CSV로 연속 저장합니다."/>
                        <CheckBox x:Name="PauseCheck" Content="화면 일시정지" Margin="8,0,12,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="OnlyKeywordCheck" Content="키워드 일치만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
                        <CheckBox x:Name="OutgoingOnlyCheck" Content="송신(OUT)만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="선택 캡처 어댑터에서 외부로 나가는 패킷만 표시합니다."/>
                        <CheckBox x:Name="ExternalOnlyCheck" Content="외부 통신만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="사설/로컬 IPv4와 Public IPv4 사이의 통신만 표시합니다."/>
                        <CheckBox x:Name="SecurityOnlyCheck" Content="보안 의심만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="관계도 보안 분석에서 WATCH 이상으로 분류되거나 외부 주의 포트를 사용하는 패킷만 표시합니다."/>
                        <CheckBox x:Name="BeaconOnlyCheck" Content="비콘 후보만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="동일 외부 목적지로 일정 주기 반복 연결되어 Beaconing 후보로 분류된 흐름만 표시합니다."/>
                        <CheckBox x:Name="BaselineOnlyCheck" Content="Baseline 이탈만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="해당 장비의 평소 시간대별 통신량/연결 패턴에서 유의하게 벗어난 패킷만 표시합니다."/>
                        <CheckBox x:Name="LateralOnlyCheck" Content="횡적 이동 후보만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="SMB/RDP/WinRM/SSH 등 내부 관리 포트로 여러 장비에 확산되는 후보 패킷만 표시합니다."/>
                        <CheckBox x:Name="DnsAnomalyOnlyCheck" Content="DNS 이상만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="NXDOMAIN 비율, 긴 질의명, 고유 질의 급증 등 DNS 이상 패턴으로 분류된 장비의 DNS 패킷만 표시합니다."/>
                        <CheckBox x:Name="PolicyOnlyCheck" Content="정책 제외만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="보안 정책 Allowlist에 의해 외부 목적지/도메인/서비스/포트가 정상 예외 처리된 패킷만 표시합니다. 정책 검증에 사용합니다."/>
                        <CheckBox x:Name="SynOnlyCheck" Content="TCP SYN만" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"
                                  ToolTip="TCP 연결 시작(SYN, ACK 제외) 패킷만 표시합니다. Fan-out/Host Sweep/Port Sweep 확인에 유용합니다."/>
                        <CheckBox x:Name="PreviewCheck" Content="평문 미리보기" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="HTTPS/TLS는 복호화하지 않습니다. HTTP/FTP/Telnet 등 캡처에서 보이는 평문만 미리보며 민감값 패턴은 마스킹합니다."/>
                        <TextBlock Text="프로토콜" VerticalAlignment="Center" Foreground="#888" Margin="0,0,5,0"/>
                        <TextBox x:Name="ProtocolFilterBox" Width="66" Margin="0,0,8,0" TextChanged="FilterTextChanged" ToolTip="예: TCP, UDP, ICMP. 비우면 전체"/>
                        <TextBlock Text="포트" VerticalAlignment="Center" Foreground="#888" Margin="0,0,5,0"/>
                        <TextBox x:Name="PortFilterBox" Width="82" Margin="0,0,8,0" TextChanged="FilterTextChanged" ToolTip="예: 443 또는 22,3389. Source/Destination 포트 모두 검사"/>
                        <TextBlock Text="검색" VerticalAlignment="Center" Foreground="#888" Margin="0,0,5,0"/>
                        <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBox_TextChanged" ToolTip="IP, 포트, 프로토콜, 보안 사유, 요약, 키워드에서 검색"/>
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="460"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#171717" BorderBrush="#343434" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,6,0"><TextBlock x:Name="CaptureStateText" Text="CAPTURE OFF" Foreground="#8E8E8E"/></Border>
                            <Border Background="#171717" BorderBrush="#343434" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,6,0"><TextBlock x:Name="CoverageStateText" Text="LOCAL HOST" Foreground="#9E9E9E"/></Border>
                            <Border Background="#171717" BorderBrush="#343434" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,6,0"><TextBlock x:Name="PacketCountText" Text="0 packets" Foreground="#BDBDBD"/></Border>
                            <Border Background="#171717" BorderBrush="#343434" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,6,0"><TextBlock x:Name="MatchCountText" Text="0 matches" Foreground="#FAD83B"/></Border>
                            <Border Background="#171717" BorderBrush="#343434" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,6,0"><TextBlock x:Name="AuditStateText" Text="AUDIT OFF" Foreground="#8E8E8E"/></Border>
                            <TextBlock x:Name="DropText" Foreground="#A46D5E" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="주요 키워드" Foreground="#AFAFAF" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource TraceButton}" Content="저장/적용" Padding="8,4" Margin="5,0,0,0" Click="SaveKeywords_Click"/>
                                <TextBox x:Name="KeywordsBox" Height="30" VerticalContentAlignment="Center" ToolTip="쉼표, 세미콜론 또는 줄바꿈으로 구분. 기존 표시 패킷에도 즉시 다시 적용됩니다."/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <DataGrid x:Name="PacketGrid" ItemsSource="{Binding PacketView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#151515" BorderBrush="#303030" BorderThickness="0"
                          RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시간" Binding="{Binding TimeText}" Width="92" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="방향" Binding="{Binding Direction}" Width="58" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="132" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="S.Port" Binding="{Binding SourcePortText}" Width="68" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding DestinationIp}" Width="132" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="D.Port" Binding="{Binding DestinationPortText}" Width="68" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="서비스" Binding="{Binding Service}" Width="125" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="보안" Binding="{Binding SecurityText}" Width="245" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="95" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="크기" Binding="{Binding LengthText}" Width="75" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="프로토콜 해석" Binding="{Binding Summary}" Width="300" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="키워드" Binding="{Binding KeywordHits}" Width="180" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="본문 미리보기 (민감값 마스킹)" Binding="{Binding Preview}" Width="520" ElementStyle="{StaticResource DataGridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="3" Background="#0A0A0A">
                <TextBlock Margin="10,0" VerticalAlignment="Center" Foreground="#777" FontSize="9.6"
                           Text="LOCAL HOST는 실행 PC 중심 관측입니다. SPAN/TAP 모드에서는 실행 PC와 무관한 Transit Unicast가 실제로 확인되어야 전체망 관측으로 표시합니다. HTTPS 본문은 복호화하지 않으며 감사 기록에는 통신 메타데이터와 마스킹된 미리보기만 저장합니다."/>
            </Grid>
        </Grid>
    </Border>
</Window>
