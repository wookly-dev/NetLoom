<Window x:Class="NetLoom.App.Windows.WifiAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Wi-Fi 보안 점검"
        Width="920" Height="690" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#111111" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FAD83B"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#243545"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#171717"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2C2C2C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowBackground" Value="#171717"/>
            <Setter Property="AlternatingRowBackground" Value="#191919"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202A32"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24425A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource NetLoomDataGridCellBase}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#272727"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuditWrapText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0A0A" BorderThickness="1" Background="#111111">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Wi-Fi 보안 점검" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="  /  Windows WLAN" Foreground="#777777" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="Close_Click">
                    <Viewbox Width="10" Height="10"><Canvas Width="10" Height="10"><Line X1="1" Y1="1" X2="9" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/><Line X1="9" Y1="1" X2="1" Y2="9" Stroke="#E8E8E8" StrokeThickness="1.15"/></Canvas></Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="AdapterText" Foreground="#F2F2F2" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentText" Foreground="#A7A7A7" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#211F13" BorderBrush="#554C20" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,7,0">
                                <TextBlock x:Name="NetworkCountText" Foreground="#E7D36B" FontSize="11"/>
                            </Border>
                            <Border Background="#211717" BorderBrush="#5C3030" BorderThickness="1" CornerRadius="4" Padding="9,6">
                                <TextBlock x:Name="FindingCountText" Foreground="#F09A9A" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="주변 Wi-Fi" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,7"/>

                <DataGrid Grid.Row="2" x:Name="NetworksGrid" AlternationCount="2" RowHeight="32" MinHeight="180" HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True" FrozenColumnCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="상태" Binding="{Binding ConnectedDisplay}" Width="72" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="260" MinWidth="180" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="신호" Binding="{Binding SignalDisplay}" Width="70" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="인증" Binding="{Binding Authentication}" Width="135" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="암호화" Binding="{Binding Cipher}" Width="110" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTemplateColumn Header="평가" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SecurityGrade}" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#B7B7B7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SecurityGrade}" Value="HIGH"><Setter Property="Foreground" Value="#FF7777"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SecurityGrade}" Value="MEDIUM"><Setter Property="Foreground" Value="#F2B867"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SecurityGrade}" Value="OK"><Setter Property="Foreground" Value="#62D9A6"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="감사 발견사항" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,7"/>

                <DataGrid Grid.Row="4" x:Name="FindingsGrid" AlternationCount="2" MinHeight="120" MinRowHeight="46"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True" FrozenColumnCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="등급" Binding="{Binding Severity}" Width="75" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="165" ElementStyle="{StaticResource DataGridCellText}"/>
                        <DataGridTemplateColumn Header="발견사항" Width="230" MinWidth="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Title}" Style="{StaticResource AuditWrapText}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="근거" Width="270" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Evidence}" Style="{StaticResource AuditWrapText}" Foreground="#CFCFCF"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="권고" Width="420" MinWidth="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Recommendation}" Style="{StaticResource AuditWrapText}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="※ 비밀번호 추측·캡처·침투 없이 Windows가 제공하는 SSID/인증/암호화/신호 정보만 점검합니다."
                               Foreground="#777777" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="닫기" Style="{StaticResource ActionButton}" Click="Close_Click" Margin="12,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
